# Your Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# The ID of the channel where status updates are posted
# Right-click the channel in Discord > Copy Channel ID (needs Developer Mode on)
DISCORD_CHANNEL_ID=123456789012345678

# Minecraft server host — use localhost if the bot runs on the same machine
MC_HOST=localhost
MC_PORT=25565

# Full path to your server jar file
# Windows example: C:\Users\YourName\minecraft-server\server.jar
JAR_PATH=C:\path\to\your\server.jar

# Java memory flags passed when starting the server
JAVA_ARGS=-Xmx4G -Xms2G
